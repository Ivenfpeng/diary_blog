{
	email {$CADDY_EMAIL}
}

(blog_proxy) {
	encode zstd gzip

	@media_upload path /api/admin/media
	request_body @media_upload {
		max_size 10MiB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	reverse_proxy blog:8080
}

http://localhost {
	import blog_proxy
}

{$BLOG_DOMAIN} {
	import blog_proxy
}
