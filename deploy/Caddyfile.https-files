(blog_proxy) {
	encode zstd gzip

	@media_upload path /api/admin/media
	request_body @media_upload {
		max_size 10MiB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	reverse_proxy blog:8080
}

{$BLOG_SITE_ADDRESS} {
	tls {$TLS_CERT_FILE:/certs/fullchain.pem} {$TLS_KEY_FILE:/certs/privkey.pem}
	import blog_proxy
}
